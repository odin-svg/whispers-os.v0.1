#!/bin/bash
set -e

echo "whispers" > /etc/hostname
sed -i 's/127.0.1.1.*$/127.0.1.1 whispers/' /etc/hosts || echo "127.0.1.1 whispers" >> /etc/hosts

cat > /etc/os-release << 'EOF'
PRETTY_NAME="Whispers OS 1.0"
NAME="Whispers OS"
VERSION_ID="1.0"
VERSION="1.0 (Bookworm)"
VERSION_CODENAME=bookworm
ID=whispers
ID_LIKE=debian
EOF

echo "Welcome to Whispers OS" > /etc/issue
